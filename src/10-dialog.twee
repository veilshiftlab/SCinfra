:: DialogMacro [script]
/* =========================================================================
 * Module: dialog - colorized character dialogue, backed by the NPC catalog.
 *
 * Usage:
 *   <<dialog "npc_id">>Spoken text, including multiple lines.<</dialog>>
 *
 * The first argument is an NPC id, NOT a raw color.  The NPC's color (and
 * any other catalogued properties) are looked up in setup.npcs.  This keeps
 * presentation data in one place — the catalog — so story passages never
 * hardcode colors and a single NPC recolor propagates everywhere.
 *
 * To add a new speaker, register them in 07-catalogue.twee:
 *
 *   setup.npcs.register("dean", {
 *       name: "Dean Fogekirk",
 *       color: "#f1c40f",
 *       portrait: "assets/characters/dean.png"  // optional
 *   });
 *
 * NPCs can also be flagged `silence: true` to suppress the unknown-NPC
 * error (handy for unimplemented placeholders during development).
 * ========================================================================= */
(function () {
        "use strict";

        function text(value) {
                return value == null ? "" : String(value);
        }

        Macro.add("dialog", {
                tags: [],
                handler: function () {
                        if (!this.args.length || !text(this.args[0]).trim()) {
                                return this.error('usage: <<dialog "npc_id">>text<</dialog>>');
                        }

                        var npcId = text(this.args[0]).trim();
                        var npc = setup.npcs.get(npcId);
                        if (!npc) {
                                return this.error(
                                        'unknown NPC "' + npcId + '" — register it via ' +
                                        'setup.npcs.register("' + npcId + '", { name: "...", color: "..." })'
                                );
                        }

                        var el = document.createElement("span");
                        el.className = "dialog dialog--" + npcId;
                        el.style.color = npc.color;
                        el.setAttribute("data-npc", npcId);
                        if (npc.name) el.setAttribute("title", npc.name);
                        this.output.appendChild(el);

                        if (this.payload[0] && this.payload[0].contents) {
                                new Wikifier(el, this.payload[0].contents);
                        }
                }
        });
})();
