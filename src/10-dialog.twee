:: DialogMacro [script]
/* =========================================================================
 * Module: dialog - colorized character dialogue + prose name coloring,
 * backed by the NPC catalog.
 *
 * Macros:
 *   <<dialog "npc_id">>Spoken text.<</dialog>>
 *       Renders the spoken text in the NPC's dialog color. The NPC must
 *       be registered in setup.npcs.
 *
 *   <<name "npc_id">>
 *       Renders the NPC's display name in their dialog color, inline
 *       within prose. Use this whenever you write a character's name in
 *       narration so the player associates the name color with the
 *       dialog color — they'll know who's about to speak.
 *
 *       Authoring rule: ALWAYS use <<name "uncle">> in prose, never
 *       write the name raw. One raw name breaks the color association.
 *
 * Both macros source their color from setup.npcs so recoloring an NPC
 * is a one-line change in 07-catalogue.twee that propagates everywhere.
 * ========================================================================= */
(function () {
        "use strict";

        function text(value) {
                return value == null ? "" : String(value);
        }

        Macro.add("dialog", {
                tags: [],
                handler: function () {
                        if (!this.args.length || !text(this.args[0]).trim()) {
                                return this.error('usage: <<dialog "npc_id">>text<</dialog>>');
                        }

                        var npcId = text(this.args[0]).trim();
                        var npc = setup.npcs.get(npcId);
                        if (!npc) {
                                return this.error(
                                        'unknown NPC "' + npcId + '" — register it via ' +
                                        'setup.npcs.register("' + npcId + '", { name: "...", color: "..." })'
                                );
                        }

                        var el = document.createElement("span");
                        el.className = "dialog dialog--" + npcId;
                        el.style.color = npc.color;
                        el.setAttribute("data-npc", npcId);
                        if (npc.name) el.setAttribute("title", npc.name);
                        this.output.appendChild(el);

                        if (this.payload[0] && this.payload[0].contents) {
                                new Wikifier(el, this.payload[0].contents);
                        }
                }
        });

        Macro.add("name", {
                handler: function () {
                        if (!this.args.length || !text(this.args[0]).trim()) {
                                return this.error('usage: <<name "npc_id">>');
                        }

                        var npcId = text(this.args[0]).trim();
                        var npc = setup.npcs.get(npcId);
                        if (!npc) {
                                return this.error(
                                        'unknown NPC "' + npcId + '" — register it via ' +
                                        'setup.npcs.register("' + npcId + '", { name: "...", color: "..." })'
                                );
                        }

                        var el = document.createElement("span");
                        el.className = "npc-name npc-name--" + npcId;
                        el.style.color = npc.color;
                        el.setAttribute("data-npc", npcId);
                        el.textContent = npc.name || npcId;
                        this.output.appendChild(el);
                }
        });
})();
