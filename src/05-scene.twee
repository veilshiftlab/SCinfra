:: SceneScript [script]
/* =========================================================================
 * Module: scene — pixel-perfect scene canvas manager.
 *
 * The scene canvas is the full-width 4:1 strip at the top of the main area.
 * It holds two kinds of layer, both passage-scoped:
 *
 *   1. Background image  - set via setup.scene.setImage(url) or the
 *                          <<sceneImage>> macro. Fills the canvas with
 *                          object-fit: fill (4:1 assets at the design
 *                          resolution are 1:1; smaller pixel-art assets
 *                          upscale via nearest-neighbour).
 *   2. Character layers  - set via setup.scene.addCharacter(url, opts) or
 *                          the <<characterImage>> macro. Stacks on top of
 *                          the background; many at once (one per call).
 *
 * All image layers use image-rendering: pixelated (set in ShellStyle) so
 * pixel-art assets stay crisp at any scale — no anti-aliasing.
 *
 * All layers are removed automatically when the passage that placed them
 * ends — see the :passagestart / :passageend hooks at the bottom of this
 * file. Callers can also clear them manually:
 *
 *   setup.scene.clear()             - clears background + all characters
 *   setup.scene.clearCharacters()   - clears characters only
 * ========================================================================= */
(function () {
        "use strict";

        var canvasEl = null;
        var bgImageEl = null;
        var bgPassage = null;
        var characterEls = [];

        function getElement() {
                if (!canvasEl) {
                        canvasEl = document.getElementById("scene-canvas");
                }
                return canvasEl;
        }

        /* ------------------------------------------------------------------
         * Path resolution helper.
         *
         * SugarCube's macro argument parser can interpret a bare slash as
         * division (e.g. `assets/scenes/room.png` becomes `assets / scenes /
         * room.png`).  We use the raw token when available so paths survive
         * intact.  Shared by <<sceneImage>> and <<characterImage>>.
         * ------------------------------------------------------------------ */
        function resolveImagePath(context) {
                var raw = context.args && context.args.raw;
                if (typeof raw === "string" && raw.trim()) {
                        raw = raw.trim();
                        if ((raw.charAt(0) === '"' && raw.charAt(raw.length - 1) === '"') ||
                                (raw.charAt(0) === "'" && raw.charAt(raw.length - 1) === "'")) {
                                return raw.slice(1, -1);
                        }
                        if (context.args.length === 1 &&
                                !/^[\$_]/.test(raw) &&
                                (raw.indexOf("/") !== -1 || raw.indexOf("\\") !== -1)) {
                                return raw;
                        }
                }
                return String(context.args[0]);
        }

        /* --- Position distribution for multi-character scenes ----------- *
         * Returns {name, left?} where name is a CSS class suffix
         * ("left", "center", "right", "custom") and left is an inline
         * left% for 4+ characters (null for 1-3, which use CSS classes).
         *
         *   1 char  → center
         *   2 chars → left, right
         *   3 chars → left, center, right
         *   4+ chars → evenly spaced: left = 10% + (i/(n-1))*80%, centered
         *              via translateX(-50%). 10% side margins prevent edge
         *              clipping. */
        function distributePosition(i, n) {
                if (n <= 1) return { name: "center" };
                if (n === 2) return { name: i === 0 ? "left" : "right" };
                if (n === 3) {
                        return { name: i === 0 ? "left" : i === 1 ? "center" : "right" };
                }
                /* 4+: even distribution with 10% margins. */
                var pct = 10 + (i / (n - 1)) * 80;
                return { name: "custom", left: pct + "%" };
        }

        function clearBackground() {
                if (bgImageEl && bgImageEl.parentNode) {
                        bgImageEl.parentNode.removeChild(bgImageEl);
                }
                bgImageEl = null;
                bgPassage = null;
        }

        function clearCharacters() {
                characterEls.forEach(function (el) {
                        if (el.parentNode) el.parentNode.removeChild(el);
                });
                characterEls = [];
        }

        setup.scene = {
                getElement: getElement,
                resolveImagePath: resolveImagePath,

                /* --- Background image ------------------------------------- *
                 * The CSS sets object-fit: fill + image-rendering: pixelated,
                 * so we don't need any JS fit logic. We just create the <img>
                 * and append it to the canvas. */
                setImage: function (url) {
                        var canvas = getElement();
                        if (!canvas) return;
                        if (bgImageEl) clearBackground();

                        bgPassage = State.passage;

                        bgImageEl = document.createElement("img");
                        bgImageEl.className = "scene-canvas__image";
                        bgImageEl.src = url;
                        bgImageEl.alt = "";
                        bgImageEl.setAttribute("aria-hidden", "true");
                        canvas.appendChild(bgImageEl);
                },

                clearImage: function () {
                        clearBackground();
                },

                setColor: function (color) {
                        var el = getElement();
                        if (!el) return;
                        el.style.backgroundColor = color || "#000";
                },

                /* --- Character layers ------------------------------------ */
                addCharacter: function (url, options) {
                        var canvas = getElement();
                        if (!canvas) return null;

                        options = options || {};
                        var position = options.position || "center";
                        var name = options.name || "";
                        var z = options.zIndex != null ? options.zIndex : 2 + characterEls.length;
                        var maxWidth = options.maxWidth || null;

                        var img = document.createElement("img");
                        img.className = "scene-canvas__character scene-canvas__character--" + position;
                        img.src = url;
                        img.alt = name;
                        img.setAttribute("data-character", name || "");
                        img.setAttribute("data-position", position);
                        img.style.zIndex = String(z);
                        if (maxWidth) img.style.maxWidth = maxWidth;
                        canvas.appendChild(img);
                        characterEls.push(img);

                        return img;
                },

                /* --- Multi-character batch add --------------------------- *
                 * addCharacters([{id, portrait, name}, ...]) — clears existing
                 * characters first, then adds all from the list with
                 * auto-distributed positions. Returns the array of created
                 * img elements.
                 *
                 * Position distribution:
                 *   1  → center
                 *   2  → left, right
                 *   3  → left, center, right
                 *   4+ → evenly spaced with 10% side margins (inline left %)
                 *
                 * Max-width per character scales with count so portraits
                 * don't overlap: ~60% for 1, ~45% for 2, ~30% for 3, ~20%
                 * for 4+, with small gaps. */
                addCharacters: function (chars) {
                        var canvas = getElement();
                        if (!canvas) return [];

                        clearCharacters();
                        if (!chars || !chars.length) return [];

                        var n = chars.length;
                        var maxWidth;
                        if (n <= 1) maxWidth = "60%";
                        else if (n === 2) maxWidth = "45%";
                        else if (n === 3) maxWidth = "32%";
                        else maxWidth = Math.floor(80 / n) + "%";

                        var created = [];
                        for (var i = 0; i < n; i++) {
                                var c = chars[i];
                                var pos = distributePosition(i, n);
                                var img = this.addCharacter(c.portrait, {
                                        position: pos.name,
                                        name: c.id,
                                        maxWidth: maxWidth
                                });
                                /* For 4+ characters, distributePosition returns
                                 * a custom left% — apply it as an inline style. */
                                if (pos.left != null) {
                                        img.style.left = pos.left;
                                        img.style.right = "auto";
                                        img.style.transform = "translateX(-50%)";
                                }
                                created.push(img);
                        }
                        return created;
                },

                removeCharacter: function (name) {
                        characterEls = characterEls.filter(function (el) {
                                if (el.getAttribute("data-character") === name) {
                                        if (el.parentNode) el.parentNode.removeChild(el);
                                        return false;
                                }
                                return true;
                        });
                },

                clearCharacters: clearCharacters,

                /* --- Nuclear option -------------------------------------- */
                clear: function () {
                        clearBackground();
                        clearCharacters();
                },

                /* --- Introspection --------------------------------------- */
                getBackground: function () { return bgImageEl; },
                getCharacters: function () { return characterEls.slice(); },
                hasContent: function () { return !!bgImageEl || characterEls.length > 0; }
        };

        /* ==================================================================
         * Macros
         * ================================================================== */

        Macro.add("sceneImage", {
                handler: function () {
                        var path = resolveImagePath(this);
                        if (!this.args.length || !path.trim()) {
                                return this.error('usage: <<sceneImage "path/to/image.png">>');
                        }
                        var canvas = getElement();
                        if (!canvas) return this.error("scene canvas not found");
                        setup.scene.setImage(path);
                }
        });

        /* <<characterImage "path" [position] [name]>>
         *   position - "left" | "center" (default) | "right" | "far-left" | "far-right"
         *   name     - optional character id (for removal / debugging)
         *
         * Multiple calls stack.  All layers clear when the passage ends.
         * Use this for explicit single-character control. For multi-character
         * scenes, use <<characters>> instead. */
        Macro.add("characterImage", {
                handler: function () {
                        var path = resolveImagePath(this);
                        if (!this.args.length || !path.trim()) {
                                return this.error('usage: <<characterImage "path/to/image.png" [position] [name]>>');
                        }
                        var canvas = getElement();
                        if (!canvas) return this.error("scene canvas not found");

                        var position = this.args[1] ? String(this.args[1]) : "center";
                        var name = this.args[2] ? String(this.args[2]) : "";

                        setup.scene.addCharacter(path, { position: position, name: name });
                }
        });

        /* <<characters "npc1" "npc2" "npc3" ...>>
         *
         * Adds multiple character portraits to the scene canvas in a single
         * call. Each argument is an NPC id (looked up in setup.npcs). The
         * portrait path comes from the NPC's `portrait` field in the catalog.
         *
         * Positions are auto-distributed based on count:
         *   1  → center
         *   2  → left, right
         *   3  → left, center, right
         *   4+ → evenly spaced with 10% side margins
         *
         * Max-width per portrait scales with count so they don't overlap.
         * Existing characters are cleared first (idempotent).
         *
         * Example:
         *   <<characters "uncle" "librarian">>
         *   <<characters "dean">>
         *
         * To register a portrait for an NPC, set the `portrait` field in
         * 07-catalogue.twee:
         *   setup.npcs.register("uncle", {
         *       name: "Uncle",
         *       color: "#e74c3c",
         *       portrait: "assets/characters/uncle.png"
         *   }); */
        Macro.add("characters", {
                handler: function () {
                        if (!this.args.length) {
                                return this.error('usage: <<characters "npc1" "npc2" ...>>');
                        }
                        var canvas = getElement();
                        if (!canvas) return this.error("scene canvas not found");

                        var chars = [];
                        for (var i = 0; i < this.args.length; i++) {
                                var id = String(this.args[i]).trim();
                                var npc = setup.npcs.get(id);
                                if (!npc) {
                                        return this.error(
                                                'unknown NPC "' + id + '" — register it via ' +
                                                'setup.npcs.register("' + id + '", {...})'
                                        );
                                }
                                if (!npc.portrait) {
                                        return this.error(
                                                'NPC "' + id + '" has no portrait — set the ' +
                                                '`portrait` field in setup.npcs.register("' + id + '", ' +
                                                '{portrait: "assets/characters/' + id + '.png"})'
                                        );
                                }
                                chars.push({ id: id, portrait: npc.portrait, name: npc.name });
                        }

                        setup.scene.addCharacters(chars);
                }
        });

        /* <<removeCharacter "name">> - remove one named character layer. */
        Macro.add("removeCharacter", {
                handler: function () {
                        if (!this.args.length) {
                                return this.error('usage: <<removeCharacter "name">>');
                        }
                        setup.scene.removeCharacter(String(this.args[0]));
                }
        });

        /* <<clearCharacters>> - remove all character layers. */
        Macro.add("clearCharacters", {
                handler: function () {
                        setup.scene.clearCharacters();
                }
        });

        /* <<clearScene>> - remove background + all characters. */
        Macro.add("clearScene", {
                handler: function () {
                        setup.scene.clear();
                }
        });

        /* ==================================================================
         * Passage-scoped lifecycle hooks
         * ================================================================== */
        function isStale() {
                return bgPassage && bgPassage !== State.passage;
        }

        $(document)
                .on(":passagestart.sceneCanvas", function () {
                        if (isStale()) {
                                setup.scene.clear();
                        }
                })
                .on(":passageend.sceneCanvas", function () {
                        if (isStale()) {
                                setup.scene.clear();
                        }
                });
})();
