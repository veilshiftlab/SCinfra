:: WidgetStyle [stylesheet]
/* =========================================================================
 * Widget primitives — visual styles.
 *
 *   - em-based sizing: scales with the sidebar font size, reflows at any
 *     #ui-bar width. Nothing fixed-width that can outrun a narrow panel.
 *   - Stock SugarCube look: grays, hairline borders, square corners, one
 *     muted accent. No gradients, no color-mix.
 *   - Table language: .ui-row-line rows share a hairline bottom border;
 *     the last row of any block drops it.
 *   - Progress bars are bordered TRACKS (margin + border + inner padding)
 *     so stacked bars never merge. The fill is the author's colour at
 *     full strength — text overlays it, so the author owns the contrast.
 *   - In a uiGrid, uiValue cells auto-group into centred value/label
 *     stacks, and gridlines use the real border colour for definition.
 * ========================================================================= */

/* --- Containers ---------------------------------------------------------- */

.ui-container {
        display: flex;
        flex-direction: column;
        gap: 0.4em;
        margin: 0 0 0.6em;
        min-width: 0;
}

.ui-container__title {
        margin: 0;
        padding: 0 0 0.25em;
        border-bottom: 1px solid var(--ui-border, #444);
        font-size: 0.8em;
        font-weight: bold;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ui-text-dim, #9a9a9a);
}

.ui-card {
        min-width: 0;
        background: var(--ui-bg-raised, #161616);
        border: 1px solid var(--ui-border, #444);
        box-shadow: var(--shadow-z1, none);
        color: var(--ui-text, #eee);
}

.ui-card__title {
        padding: 0.35em 0.7em;
        border-bottom: 1px solid var(--ui-border, #444);
        font-size: 0.8em;
        font-weight: bold;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ui-text-dim, #9a9a9a);
}

.ui-card__body {
        padding: 0.15em 0.7em;
        min-width: 0;
        color: var(--ui-text, #eee);
}

.ui-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5em;
        margin: 0.2em 0;
        min-width: 0;
}
.ui-row > * { flex: 1 1 auto; min-width: 0; }

/* --- Shared table-row primitive ------------------------------------------- */

.ui-row-line {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.25em 0.75em;
        padding: 0.3em 0;
        border-bottom: 1px solid var(--ui-border-faint, #2c2c2c);
        line-height: 1.35;
        min-width: 0;
        color: var(--ui-text, #eee);
}
.ui-row-line:last-child { border-bottom: 0; }

.ui-label {
        line-height: 1.4;
        overflow-wrap: break-word;
        color: var(--ui-text, #eee);
}

/* --- Label / value --------------------------------------------------------- */

.ui-value__label {
        flex: 1 1 auto;
        color: var(--ui-text-dim, #9a9a9a);
        overflow-wrap: break-word;
}
.ui-value__value {
        flex: 0 0 auto;
        font-weight: bold;
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
        color: var(--ui-text, #eee);
}
.ui-value__unit {
        margin-left: 0.25em;
        font-weight: normal;
        font-size: 0.85em;
        color: var(--ui-text-dim, #9a9a9a);
}

/* --- Progress — a bordered TRACK --------------------------------------------
 * Each bar is its own bordered rectangle with vertical margin, so stacked
 * bars read as discrete blocks (an empty bar is a clean empty track). The
 * fill is the author's colour at FULL strength — no opacity wash, no
 * leading-edge hack — and the label/value text overlays it. The author
 * therefore chooses a fill their text stays readable on. */

.ui-progress {
        position: relative;
        flex-wrap: nowrap;
        align-items: center;
        overflow: hidden;
        padding: 0.3em 0.6em;     /* inner breathing room so text isn't on the edge */
        margin: 0.25em 0;         /* gap between consecutive bars */
        border: 1px solid var(--ui-border, #444);   /* the track edge */
        --ui-progress-color: var(--ui-accent, #4c73b0);
        --ui-progress-pct: 0%;
}
/* Restore the bottom edge when a bar happens to be the last child
 * (.ui-row-line:last-child would otherwise strip it). */
.ui-progress:last-child { border-bottom: 1px solid var(--ui-border, #444); }

.ui-progress::before {
        content: "";
        position: absolute;
        top: 0; bottom: 0; left: 0;
        width: var(--ui-progress-pct);
        background: var(--ui-progress-color);   /* full strength — author's colour */
        pointer-events: none;
        transition: width 0.15s ease-out;
}
.ui-progress__label {
        position: relative;
        z-index: 1;
        flex: 1 1 auto;
        min-width: 0;
        color: var(--ui-text, #eee);
        overflow-wrap: break-word;
}
.ui-progress__text {
        position: relative;
        z-index: 1;
        flex: 0 0 auto;
        font-size: 0.85em;
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
        color: var(--ui-text, #eee);
}

/* --- Read-only checkbox row ------------------------------------------------- */

.ui-check { align-items: center; }
.ui-check__label {
        flex: 1 1 auto;
        color: var(--ui-text-dim, #9a9a9a);
        overflow-wrap: break-word;
}
.ui-check.is-checked .ui-check__label { color: var(--ui-text, #eee); }
.ui-check__box {
        flex: 0 0 auto;
        width: 1.05em;
        height: 1.05em;
        border: 1px solid var(--ui-border, #444);
        position: relative;
}
.ui-check.is-checked .ui-check__box { border-color: var(--ui-accent, #4c73b0); }
.ui-check.is-checked .ui-check__box::after {
        content: "\2713";
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85em;
        line-height: 1;
        color: var(--ui-accent, #4c73b0);
}

/* --- Willpower pips -----------------------------------------------------------
 * Pips pack into a 5-column grid (2 rows × 5 cols for the default cap of 10),
 * so they read as a compact block instead of a long single row. The grid
 * sits to the right of the label.
 */

.wp-pips { align-items: center; }
.wp-pips__label {
        flex: 0 0 auto;
        font-size: 0.9em;
        color: var(--ui-text-dim, #9a9a9a);
}
.wp-pips__grid {
        display: grid;
        grid-template-columns: repeat(5, auto);
        justify-content: flex-end;
        gap: 0.3em;
        flex: 1 1 auto;
        min-width: 0;
}
.wp-pip {
        width: 0.7em;
        height: 0.7em;
        border: 1px solid var(--ui-border, #444);
        border-radius: 50%;
        transition: background-color 0.12s ease, border-color 0.12s ease;
}
.wp-pip.is-filled {
        background: var(--ui-accent, #4c73b0);
        border-color: var(--ui-accent, #4c73b0);
}

/* --- Note line ------------------------------------------------------------------- */

.ui-note {
        padding: 0.2em 0;
        font-size: 0.85em;
        font-style: italic;
        line-height: 1.45;
        color: var(--ui-text-dim, #9a9a9a);
        overflow-wrap: break-word;
}

/* --- List ------------------------------------------------------------------------- */

.ui-list {
        margin: 0.25em 0;
        padding-left: 1.5em;
        list-style: square outside;
}
.ui-list__item { margin: 0.15em 0; line-height: 1.4; }
.ui-list__item::marker { color: var(--ui-text-dim, #9a9a9a); }

/* --- Stat grid -----------------------------------------------------------------------
 * Ruled cells: the grid's own background shows through the 1px gaps as
 * gridlines in the real border colour (clear definition). minmax(5em,…)
 * keeps two cells viable in a stock-width sidebar. */

.ui-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(5em, 1fr));
        gap: 1px;
        margin: 0.3em 0;
        background: var(--ui-border, #444);          /* gridline colour */
        border: 1px solid var(--ui-border, #444);
        color: var(--ui-text, #eee);
}
.ui-grid > * {
        min-width: 0;
        padding: 0.5em 0.6em;
        background: var(--ui-bg-raised, #161616);    /* cell face */
}

.ui-stat { text-align: center; }
.ui-stat__value {
        font-size: 1.15em;
        font-weight: bold;
        line-height: 1.2;
        font-variant-numeric: tabular-nums;
}
.ui-stat__label {
        margin-top: 0.1em;
        font-size: 0.7em;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ui-text-dim, #9a9a9a);
}

/* A uiValue dropped into a grid collapses into a centred, grouped cell:
 * bold value on top, small-caps label beneath — no edge-to-edge spread. */
.ui-grid > .ui-value {
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 0.1em;
        padding: 0.5em 0.6em;
        border-bottom: 0;
}
.ui-grid > .ui-value .ui-value__value { order: 1; flex: none; }
.ui-grid > .ui-value .ui-value__label {
        order: 2;
        flex: none;
        font-size: 0.7em;
        letter-spacing: 0.06em;
        text-transform: uppercase;
}

/* --- Inline tag ------------------------------------------------------------------------- */

.ui-tag {
        display: inline-block;
        padding: 0 0.45em;
        border: 1px solid var(--ui-border, #444);
        font-size: 0.8em;
        line-height: 1.7;
        white-space: nowrap;
        color: var(--ui-text-dim, #9a9a9a);
}
.ui-tag--accent { border-color: var(--ui-accent, #4c73b0); color: var(--ui-accent, #4c73b0); }
.ui-tag--buff   { border-color: #6a9955; color: #6a9955; }
.ui-tag--debuff { border-color: #a85454; color: #a85454; }

/* --- Divider / spacer ---------------------------------------------------------------------- */

.ui-divider {
        display: flex;
        align-items: center;
        gap: 0.6em;
        margin: 0.35em 0;
        font-size: 0.75em;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ui-text-dim, #9a9a9a);
}
.ui-divider::before,
.ui-divider::after {
        content: "";
        flex: 1;
        border-top: 1px solid var(--ui-border-faint, #2c2c2c);
}
.ui-divider:empty::after { display: none; }

/* Vertical divider — a thin upright rule for separating adjacent items
 * inside a <<uiRow>> (e.g. Money | Debt). It self-centres vertically and
 * takes no flex width so the row's space-between layout is preserved. */
.ui-divider-v {
        flex: 0 0 auto;
        width: 0;
        align-self: stretch;
        margin: 0.15em 0.25em;
        border-left: 1px solid var(--ui-border-faint, #2c2c2c);
}

.ui-spacer { flex: 1 1 auto; min-height: 0.5em; }

/* --- Text styling primitives (uiText / uiCenter) ------------------------
 * For composing custom displays (clocks, date lines, meta info) from
 * leaf macros like <<uiHour>>, <<uiDate>>, etc. All variants center
 * their text by default — override with text-align if needed.
 *
 * Usage:
 *   <<uiText "clock">><<uiHour "12h">>:<<uiMinute>> <<uiAmpm>><</uiText>>
 *   <<uiText "date">><<uiDate>>/<<uiMonth>>/<<uiYear>><</uiText>>
 *   <<uiText "meta">><<uiDay>> · <<uiPhase>><</uiText>>
 *   <<uiText "muted">>Day <<uiDays>><</uiText>>
 * ======================================================================= */

.ui-text {
        display: block;
        text-align: center;
        line-height: 1.3;
        padding: 0.1em 0;
        border: 1px solid var(--ui-border, #444);
        color: var(--ui-text, #eee);
}

/* clock — large, bold, tabular numbers. For the main time display. */
.ui-text--clock {
        font-size: 1.5em;
        font-weight: bold;
        font-variant-numeric: tabular-nums;
        letter-spacing: 0.04em;
        color: var(--ui-text, #eee);
        padding: 0.15em 0;
}

/* date — medium weight, normal color. For date strings. */
.ui-text--date {
        font-size: 1em;
        font-variant-numeric: tabular-nums;
        color: var(--ui-text, #eee);
}

/* meta — small, uppercase, dim. For day/phase/metadata lines.
 * Uses inline-flex so child elements (including <<uiDividerV>>) lay
 * out horizontally with proper centering and spacing. */
.ui-text--meta {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5em;
        font-size: 0.75em;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ui-text-dim, #9a9a9a);
}

/* muted — dim color, normal size. */
.ui-text--muted {
        color: var(--ui-text-dim, #9a9a9a);
}

/* accent — accent color, normal size. */
.ui-text--accent {
        color: var(--ui-accent, #4c73b0);
        font-weight: bold;
}

/* bold — bold weight, normal color. */
.ui-text--bold {
        font-weight: bold;
        color: var(--ui-text, #eee);
}

/* --- Centering container ------------------------------------------------
 * Centers its children horizontally. Children keep natural width.
 * Use inside a <<uiCard>> when you want content centered rather
 * than stretched edge-to-edge. */
.ui-center {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.2em;
        min-width: 0;
}