:: PanelLeft[nobr]
/%
        Left sidebar — title placeholder, time, resources, actions.

        Layout (top to bottom in the sidebar-body grid):
            Time card        — top
            Resources card   — top (grouped with Time as "game state")
            [spacer]         — absorbs all extra space (inserted by ShellScript)
            Actions card     — bottom (engine state)

        The 1fr spacer between Resources and Actions creates a clear
        logical separation: game state at the top, engine controls at
        the bottom. Time and Resources sit together; Actions is pinned
        at the bottom edge.

        Back/forward use <<uiGrid>> (two equal columns). The .ui-action
        buttons now size via --ui-unit so they grow proportionally with
        the base height — no more cramped look.

        The title placeholder in <header> will be replaced with a game
        title PNG later.
%/
<header class="sidebar-header"><h1 id="story-title"><<= Story.title>></h1></header>

<<uiCard "Time">>
        <<uiText "clock">><<uiHour "12h">>:<<uiMinute>> <<uiAmpm>><</uiText>>
        <<uiGrid>><<uiText>><<uiDay>><</uiText>><<uiText>><<uiPhase>><</uiText>><</uiGrid>>
        <<uiText "date">><<uiDate>>/<<uiMonth>>/<<uiYear>><</uiText>>
        <<uiText "muted">>Day <<uiDays>><</uiText>>
<</uiCard>>

<<uiCard "Resources">>
        <<uiProgress "Stamina"  $resources.stamina  $resources.maxStamina  "#2ecc71">>
        <<uiProgress "Stress"   $resources.stress   $resources.maxStress   "#e67e22">>
        <<uiProgress "Hunger"   $resources.hunger   $resources.maxHunger   "#f39c12">>
        <<uiDivider>>
        <<willpowerPips>>
        <<uiGrid>>
                <<uiValue "Money" $resources.money>>
                <<uiValue "Debt"  $resources.debt>>
        <</uiGrid>>
<</uiCard>>

<<uiCard "Actions">>
        <<uiGrid>>
                <<uiAction "back">>
                <<uiAction "forward">>
        <</uiGrid>>
        <<uiAction "saves">>
        <<uiAction "settings">>
        <<uiAction "restart">>
<</uiCard>>
